# 복사해서 .env 로 저장하세요. .env 는 절대 커밋하지 마세요.

# 증권사 선택: mock (키 없이 모의 시세, 기본값) | kiwoom (키움 REST API) | kis (한국투자증권)
BROKER=mock

# ── 키움 REST API (https://openapi.kiwoom.com) ──
# real  : 실전 서버 api.kiwoom.com      paper : 모의투자 서버 mockapi.kiwoom.com
# 키는 실전용/모의투자용이 따로 발급되며 서로 바꿔 쓸 수 없다 (오류 8030). 사이트에서 사용할 PC 의 IP 를 먼저 등록해야 한다.
KIWOOM_ENV=real
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
# 초당 조회 수 · 거래대금 단위(백만원). 보통 바꿀 필요 없음
#KIWOOM_RPS=4
#KIWOOM_AMOUNT_UNIT=1000000

# ── 한국투자증권 (BROKER=kis 일 때) ──
# vts   : 모의투자 서버 (openapivts / ops:31000)     real  : 실전 서버 (openapi / ops:21000)
KIS_ENV=vts
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리-뒤 2자리 (주문 기능을 붙일 때만 필요)
KIS_ACCOUNT_NO=

HOST=127.0.0.1
PORT=8000

# 테마 자동 수집 (네이버 금융 테마 페이지). 분 단위 주기, 0 이면 끔.
# 켜면 평일 08:50~15:30 사이에만 돈다. 화면의 '테마 수집' 버튼이나 scripts/collect_themes.py 로 수동 실행도 가능.
THEME_COLLECT_MINUTES=0
THEME_COLLECT_TOP=12
THEME_COLLECT_PER=6

# 테마 카드의 리포트 줄(증권사 리포트 건수)·뉴스 줄(대장주 최신 기사) 갱신 주기(분). 0 이면 테마 수집 때만.
NEWS_MINUTES=10
REPORT_DAYS=7

# 야간 지표 (전일 20:05 대비 나스닥·유가·환율 등, 야후 파이낸스). 분 단위 주기, 0 이면 끔.
OVERNIGHT_MINUTES=5

# 외인 선물 (코스피200 선물 외국인 순매수 계약). 기본 naver = 네이버 투자자별 매매동향 (키 불필요, 장중 잠정치).
# kis 로 바꾸면 한국투자증권 API 로 조회하며 아래 설정을 쓴다 (계정·문서 버전에 따라 다를 수 있음).
#FUT_SOURCE=naver
#KIS_FUT_PATH=/uapi/domestic-stock/v1/quotations/inquire-investor-daily-by-market
#KIS_FUT_TR_ID=FHPTJ04040000
#KIS_FUT_PARAMS={"FID_INPUT_ISCD": "F001", "FID_INPUT_DATE_1": "{today}"}
#KIS_FUT_FIELD=frgn_ntby_qty
